# Скопируй в .env и заполни значения. Файл .env не коммитится.

# Neon → Connect → Connection pooling ВКЛЮЧЁН (хост с -pooler). Использует приложение.
DATABASE_URL=

# Neon → Connect → Connection pooling ВЫКЛЮЧЕН. Используют миграции (drizzle-kit).
DATABASE_URL_UNPOOLED=

# Neon → Settings → Auth: адрес Neon Auth этой ветки.
NEON_AUTH_BASE_URL=

# Секрет подписи cookie сессии, не короче 32 символов: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
